@model MessageInboxView
@* TODO: Change patient/staff routes to use hardcoded InboxTypes *@

@{
    string activeInbox = Model.InboxFilters.IsPatientInbox ? "patient" : "staff";
    var inboxTabs = new[]
    {
        new { Label = "Patient", Route = "patient", IsActive = Model.InboxFilters.IsPatientInbox, UnreadCount = Model.UnreadPatient },
        new { Label = "Staff", Route = "staff", IsActive = !Model.InboxFilters.IsPatientInbox, UnreadCount = Model.UnreadStaff },
    };
}

<div class="d-flex mt-3">
    <h4 class="my-0 me-auto">Messages <span class='badge hue-primary @(Model.UnreadTotal > 0 ? "and-dimmed" : "and-faint-light") on-bg text-dark'>@Model.UnreadTotal</span>:</h4>

    <div class="dropdown">
        <button class="btn btn-sm dropdown-toggle hue-primary and-dimmed on-btn-outline" data-bs-toggle="dropdown">+</button>
        <div class="dropdown-menu">
            <a href="#" class="dropdown-item disabled">New Message to Patient</a>
            <a asp-controller="Messaging" asp-action="NewConversationForm" class="dropdown-item">New Message to Staff</a>
        </div>
    </div>
</div>

<ul class="nav nav-tabs align-items-center justify-content-end">
    <li class="nav-item me-auto">
        <form id="unread-select" method="get" asp-controller="Messaging" asp-action="Inbox" asp-route-inbox="@activeInbox">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="InboxFilters.OnlyUnread">
                <label class="form-check-label" asp-for="InboxFilters.OnlyUnread"></label>
            </div>
        </form>
    </li>
    @foreach (var tab in inboxTabs)
    {
        string linkClasses = tab.IsActive
            ? "active hue-primary and-dimmed on-text fw-semibold"
            : "text-secondary";
        string activeTabColorClass = tab.IsActive ? "hue-primary" : "hue-secondary";
        string hasUnreadsModifierClass = tab.UnreadCount > 0 ? "and-dimmed" : "and-faint-light";
        string badgeClasses = $"{activeTabColorClass} {hasUnreadsModifierClass} on-bg text-dark";

        <li class="nav-item">
            <a class="nav-link @linkClasses" asp-controller="Messaging" asp-action="Inbox" asp-route-inbox="@tab.Route">
                @tab.Label <span class="badge @badgeClasses">@tab.UnreadCount</span>
            </a>
        </li>
    }
</ul>

<partial name="_Conversations.cshtml" />

<partial name="~/Views/Shared/_PaginationBar.cshtml" for="PaginationSettings" />

<script>
    $(document).ready(function() {
        $('#InboxFilters_OnlyUnread').on('change', function(){
            $('#unread-select').submit();
        });
    });
</script>