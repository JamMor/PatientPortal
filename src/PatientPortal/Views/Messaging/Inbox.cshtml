@model MessageInboxView
@* TODO: Change patient/staff routes to use hardcoded InboxTypes *@

<div class="d-flex mt-3">
    <h4 class="my-0 me-auto">Messages <span class='badge hue-primary @(Model.UnreadTotal > 0 ? "and-dimmed" : "and-faint-light") on-bg text-dark'>@Model.UnreadTotal</span>:</h4>

    <div class="dropdown">
        <button class="btn btn-sm dropdown-toggle hue-primary and-dimmed on-btn-outline" data-bs-toggle="dropdown">+</button>
        <div class="dropdown-menu">
            <a href="#" class="dropdown-item disabled">New Message to Patient</a>
            <a asp-controller="Messaging" asp-action="NewConversationForm" class="dropdown-item">New Message to Staff</a>
        </div>
    </div>
</div>

<ul class="nav nav-tabs align-items-center justify-content-end">
    <li class="nav-item me-auto">
        <form id="unread-select" method="get" asp-controller="Messaging" asp-action="Inbox" asp-route-inbox='@(Model.InboxFilters.IsPatientInbox ? "patient" : "staff")'>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="InboxFilters.OnlyUnread">
                <label class="form-check-label" asp-for="InboxFilters.OnlyUnread"></label>
            </div>
        </form>
    </li>
    <li class="nav-item">
        <a class='nav-link @(Model.InboxFilters.IsPatientInbox ? "active hue-primary and-dimmed on-text fw-semibold" : "text-secondary")' asp-controller="Messaging" asp-action="Inbox" asp-route-inbox="patient">Patient <span class='badge @(Model.InboxFilters.IsPatientInbox ? "hue-primary" : "hue-secondary") @(Model.UnreadPatient > 0 ? "and-dimmed" : "and-faint-light") on-bg text-dark'>@Model.UnreadPatient</span></a>
    </li>
    <li class="nav-item">
        <a class='nav-link @(!Model.InboxFilters.IsPatientInbox ? "active hue-primary and-dimmed on-text fw-semibold" : "text-secondary")' asp-controller="Messaging" asp-action="Inbox" asp-route-inbox="staff">Staff <span class='badge @(!Model.InboxFilters.IsPatientInbox ? "hue-primary" : "hue-secondary") @(Model.UnreadStaff > 0 ? "and-dimmed" : "and-faint-light") on-bg text-dark'>@Model.UnreadStaff</span></a>
    </li>
</ul>
<partial name="_Conversations.cshtml" />

@{
    ViewData["queryRoutes"] = new Dictionary<string, string>()
    {
        {"inbox", Model.InboxFilters.IsPatientInbox ? "patient" : "staff"},
        {"OnlyUnread", Model.InboxFilters.OnlyUnread.ToString()}
    };
}
<partial name="~/Views/Shared/_PaginationBar.cshtml" for="PaginationSettings" view-data="ViewData" />

<script>
    $(document).ready(function() {
        $('#InboxFilters_OnlyUnread').on('change', function(){
            $('#unread-select').submit();
        });
    });
</script>