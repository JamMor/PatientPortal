@model NewConversationFormView

<div class="form-constrained">
    <h2 class="form-title">New Message</h2>
    <form asp-controller="Messaging" asp-action="NewConversation" method="post">
        <div class="input-group mb-3">
            <button-secondary small outline class="dropdown-toggle" data-bs-toggle="dropdown">Send To</button-secondary>
            <ul class="dropdown-menu ps-3 vert-scroll">
                @if(Model.PatientRecipient != null)
                {
                    <li class="dropdown-item form-check">
                        <input class="form-check-input" type="checkbox" checked="checked" id="PatientRecipient_Id" disabled>
                        <label class="form-check-label" asp-for="PatientRecipient.Selected">@Model.PatientRecipient.Name (@Model.PatientRecipient.Role)</label>
                        <input class="form-check-input" type="hidden" asp-for="PatientRecipient.LinkId">
                    </li>
                    <li><hr class="dropdown-divider"></li>
                }
                @for(int i = 0; i < Model.Recipients.Count; i++)
                {
                <li class="dropdown-item form-check">
                    <input class="form-check-input" type="checkbox" asp-for="Recipients[i].Selected">
                    <label class="form-check-label" asp-for="Recipients[i].Selected">@Model.Recipients[i].Name, @Model.Recipients[i].Role</label>
                    <input class="form-check-input" type="hidden" asp-for="Recipients[i].LinkId">
                </li>
                }
            </ul>
            <input id="selected-recipients" type="text" class="form-control" placeholder="Recipients..." readonly>
        </div>
        <input class="form-check-input" type="hidden" asp-for="WithPatient">
        <div class="mb-3">
            <label class="form-label" asp-for="Subject"></label>
            <span class="text-danger" asp-validation-for="Subject"></span>
            <input class="form-control" asp-for="Subject">
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="MessageText"></label>
            <span class="text-danger" asp-validation-for="MessageText"></span>
            <textarea class="form-control" asp-for="MessageText"></textarea>
        </div>
        <button-primary type="submit">Send Message</button-primary>
    </form>
</div>

<script>
    $(document).ready(function() {
        $('.dropdown-menu').click(function(e) {
            e.stopPropagation();
        });

        //+1 is empty array space for possible patient.
        let totalUsers = $('input[type=checkbox]').length + 1;
        let selectedUsers = new Array(totalUsers).fill(null);

        //Replace names of all currently selected on call
        function displayNames(chosen) {
            let currentUsers = chosen.filter( x => x != null).join(";  ");
            $("#selected-recipients").val(currentUsers);
            return;
        };

        //Initialize selected users into array
        $('input[type="checkbox"]:checked').each(function() {
            let indx = parseInt($(this).attr('id').split("_")[1]);
            //If indx wasn't set to #, it is patient. Set patient to be 1st index
            if(isNaN(indx)){indx = -1};
            selectedUsers[indx + 1] = $(this).next('label').text();
            displayNames(selectedUsers);
        });

        $('input[type=checkbox]').on('change', function(){
            let indx = parseInt($(this).attr('id').split("_")[1]) + 1;
            if($(this).is(':checked')){
                selectedUsers[indx] = $(this).next('label').text();
            }
            else{
                selectedUsers[indx] = null;
            }
            displayNames(selectedUsers);
        });
    });
</script>