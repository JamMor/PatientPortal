@model ReplyView

<form asp-controller="Messaging" asp-action="NewReply" asp-route-conversationId="@Model.ConversationId" method="post">
    <div class="input-group">
        <label class="input-group-text" asp-for="MessageText"></label>
        <input class="form-control" asp-for="MessageText" placeholder="Message...">
        <button class="btn btn-info">Send</button>
    </div>
</form>
<span class="text-danger" asp-validation-for="MessageText"></span>

