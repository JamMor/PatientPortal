@using PatientPortal.Extensions
@model MessageInboxView

<table class="table">
    <thead>
        <tr>
            <th>Members</th>
            <th>Subject</th>
            <th class="d-none d-sm-table-cell">Start Date</th>
            <th>Latest<span class="d-none d-sm-inline"> Message Date</span></th>
        </tr>
    </thead>
    <tbody class="accordion table-group-divider" id="conversation-container">
        @{
            if(Model.Conversations.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No conversations to display.</td>
                </tr>
            }
        }
        @foreach (InboxConversation conversation in Model.Conversations)
        {
            string conversationRowClasses = conversation.UnreadCount() > 0
                ? "hue-brand and-faint-bright on-bg fw-bold"
                : "";

            <tr data-bs-toggle="collapse" data-bs-target="#conversation-@conversation.ConversationId" class="collapsed @conversationRowClasses">
                <td data-bs-toggle="tooltip" title="@conversation.RecipientNameString">
                    <div class="d-flex align-items-center gap-1">
                        <span class="text-truncate">@conversation.PrimaryRecipient?.Name</span>
                        @if (conversation.OtherRecipientsCount > 0)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis flex-shrink-0 ms-auto">+@conversation.OtherRecipientsCount</span>
                        }
                    </div>
                </td>
                @if(conversation.Subject != null)
                {
                    <td>@conversation.Subject</td>
                }
                else
                {
                    <td><span class='text-muted'><em>(no subject)</em></span></td>
                }
                <td class="small d-none d-sm-table-cell">
                    <span class="text-nowrap">@conversation.DateCreated.ToString("M/d/yyyy")</span>
                    <span class="text-nowrap">@conversation.DateCreated.ToString("h:mm:ss\u00a0tt")</span>
                </td>
                <td class="small">
                    <span class="text-nowrap">@conversation.DateLastMessage.ToString("M/d/yyyy")</span>
                    <span class="text-nowrap">@conversation.DateLastMessage.ToString("h:mm:ss\u00a0tt")</span>
                </td>
            </tr>
            <tr>
                <td colspan="4" class="p-0">
                    <div class="m-2 ps-2 ps-sm-5 collapse shadow-sm" id="conversation-@conversation.ConversationId" data-bs-parent="#conversation-container">
                        @foreach (InboxMessage message in conversation.Messages)
                        {
                            string messageClasses = message.Unread
                                ? "hue-brand and-faint-bright on-bg fw-bold"
                                : "";
                            string senderClasses = message.SenderId == User.GetMessageLinkId()
                                ? "hue-primary and-dimmed on-text"
                                : "hue-secondary and-dimmed on-text";
                            string senderName = conversation.GetSenderName(message.SenderId);

                            <div id="message-@message.MessageId" class="py-1 unread @messageClasses">
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="fw-bold @senderClasses">@senderName:</span>
                                    <span class="text-secondary small ms-auto">@message.Sent</span>
                                </div>
                                <p class="mb-0 ms-1">@message.MessageText</p>
                            </div>
                        }
                            <partial name="_NewReply.cshtml" model="new ReplyView(){ConversationId = conversation.ConversationId}" />
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
        $(document).ready(function() {
             $('.unread').click(function () {
                var $messageId = $(this).attr('id').split("-")[1];
                console.log($messageId);
                jQuery.post({
                    url: "/provider/inbox/message/read",
                    data: {"messageId" : $messageId},
                    success: function(data) {
                        console.log(data);
                        $("#message-" + $messageId).removeClass('fw-bold unread');
                        console.log(`Message Id ${data.messageId} marked unread.`);
                    }
                });
            });
        });
</script>