@using PatientPortal.Extensions
@model MessageInboxView

<table class="table">
    <thead>
        <tr>
            <th class="col-2">Members</th>
            <th class="col-auto">Subject</th>
            <th class="col-1">Start Date</th>
            <th class="col-1">Latest Message Date</th>
        </tr>
    </thead>
    <tbody class="accordion" id="conversation-container">
        @{
            if(Model.Conversations.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No conversations to display.</td>
                </tr>
            }
        }
        @foreach (InboxConversation conversation in Model.Conversations)
        {
            string members = String.Join(", ", conversation.Participating.Select(p => p.Name));
            string conversationRowClasses = conversation.UnreadCount() > 0
                ? "hue-brand and-faint-bright on-bg fw-bold"
                : "";

            <tr data-bs-toggle="collapse" data-bs-target="#conversation-@conversation.ConversationId" class="collapsed @conversationRowClasses">
                <td class="text-truncate td-member" data-bs-toggle="tooltip" title="@members">
                    @members
                </td>
                @if(conversation.Subject != null)
                {
                    <td>@conversation.Subject</td>
                }
                else
                {
                    <td><span class='text-muted'><em>(no subject)</em></span></td>
                }
                <td class="small">@conversation.DateCreated</td>
                <td class="small">@conversation.DateLastMessage</td>
            </tr>
            <tr>
                <td colspan="4" class="p-0">
                    <div class="m-2 ps-5 collapse shadow-sm" id="conversation-@conversation.ConversationId" data-bs-parent="#conversation-container">
                        @foreach (InboxMessage message in conversation.Messages)
                        {
                            string messageClasses = message.Unread
                                ? "hue-brand and-faint-bright on-bg fw-bold"
                                : "";
                            string senderClasses = message.SenderId == User.GetMessageLinkId()
                                ? "hue-primary and-dimmed on-text"
                                : "hue-secondary and-dimmed on-text";
                            string senderName = conversation.Participating
                                .SingleOrDefault(p => p.LinkId == message.SenderId)?.Name ?? "(unknown)";

                            <div id="message-@message.MessageId" class="d-flex p-1 unread @messageClasses">
                                <p class="fw-bold @senderClasses">@senderName:</p>
                                <p class="col-8 ms-1" colspan="2">@message.MessageText</p>
                                <p class="text-secondary small">@message.Sent</p>
                            </div>
                        }
                            <partial name="_NewReply.cshtml" model="new ReplyView(){ConversationId = conversation.ConversationId}" />
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
        $(document).ready(function() {
             $('.unread').click(function () {
                var $messageId = $(this).attr('id').split("-")[1];
                console.log($messageId);
                jQuery.post({
                    url: "/provider/inbox/message/read",
                    data: {"messageId" : $messageId},
                    success: function(data) {
                        console.log(data);
                        $("#message-" + $messageId).removeClass('fw-bold unread');
                        console.log(`Message Id ${data.messageId} marked unread.`);
                    }
                });
            });
        });
</script>