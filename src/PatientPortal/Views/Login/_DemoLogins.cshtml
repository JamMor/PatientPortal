@model IEnumerable<DemoLoginViewModel>

<h5>Demo Logins:</h5>
<div id="demo-login-container">
    <div class="container m-3">
    @if(Model != null && Model.Any())
    {
    <form id="demo-login-options" class="d-flex flex-column p-1" asp-controller="DemoLogin" asp-action="LoginDemoStaff">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <p>Staff with Staff and Patient Administrative Privileges:</p>
            <div class="d-flex demo-login mb-2">
                @foreach(var staff in Model.Where(s => s.IsDemoStaffAdmin))
                {
                    <button name='staffId' value='@staff.DemoStaffId' class='mx-1 btn btn-sm btn-primary'>
                        <span class='text-nowrap'>@staff.DemoStaffName</span>
                    </button>
                }
            </div>
            <p>Staff without Only Patient Administrative Privileges:</p>
            <div class="d-flex demo-login">
                @foreach(var staff in Model.Where(s => !s.IsDemoStaffAdmin))
                {
                    <button name='staffId' value='@staff.DemoStaffId' class='mx-1 btn btn-sm btn-warning'>
                        <span class='text-nowrap'>@staff.DemoStaffName</span>
                    </button>
                }
            </div>
    </form>
    }
    else
    {
    <form class='d-flex' method='post' action='/demo/create'>
        <button class='mx-1 btn btn-sm btn-warning'>Create Picard</button>
    </form>
    }
    
    </div>
</div>
