@model LoginStaff

<h3>Staff Login: </h3>
<form asp-action="StaffLogin" asp-controller="Login" method="post">
    <form-field asp-for="StaffUsername"></form-field>
    <form-field asp-for="LoginPassword"></form-field>
    <div asp-validation-summary="ModelOnly"></div>
    <button class="btn hue-primary and-dimmed hover-lighten on-btn">Login</button>
</form>