@model IEnumerable<TestLoginViewModel>

<h5>Demo Logins:</h5>
<div id="test-login-container">
    <div class="container m-3">
    @if(Model != null && Model.Any())
    {
    <form id="test-login-options" class="d-flex p-1 test-login" asp-controller="Test" asp-action="TestLoginOptions">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        @foreach(var staff in Model)
        {
            <button name='staffId' value='@staff.TestId' class='mx-1 btn btn-sm btn-warning'>
                Login <span class='text-nowrap'>@staff.TestName</span>
            </button>
        }
    </form>
    }
    else
    {
    <form class='d-flex' method='post' action='/test/create'>
        <button class='mx-1 btn btn-sm btn-warning'>Create Picard</button>
    </form>
    }
    
    </div>
</div>
