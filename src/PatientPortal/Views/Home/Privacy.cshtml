@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h1 class="h3 mb-3 text-center text-primary font-weight-bold">Privacy Policy</h1>
                    <div class="alert alert-warning mb-4" role="alert">
                        <p class="lead">
                            <strong>Project Notice:</strong> The PatientPortal application is
                            a demonstration and portfolio project only. It is <em>not</em> intended
                            for use with real healthcare records or sensitive personal information.
                        </p>
                        <p>
                            <strong>
                                Do not use this software for actual patient data or in any production
                                healthcare environment.
                            </strong>
                        </p>
                    </div>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item">This project is for educational and demonstration purposes only.
                        </li>
                        <li class="list-group-item">No real patient or healthcare data should be entered or stored in
                            this system.</li>
                        <li class="list-group-item">The software does <em>not</em> currently implement or guarantee
                            compliance with HIPAA, GDPR, or any other privacy or security regulations.</li>
                        <li class="list-group-item">Security features are minimal and intended for demonstration only.
                        </li>
                    </ul>
                    <div class="alert alert-secondary mb-0" role="alert">
                        If you have questions about this project, please contact the developer.
                        Do not use this application for real healthcare or personal data management.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>