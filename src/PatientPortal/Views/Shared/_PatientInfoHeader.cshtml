@model PatientHeaderInfoView

<section class="container p-3 pb-4 mb-2 shadow hue-brand and-faint-bright on-bg sticky-top">
    <hr>
    <div class="row">
        <div class="col d-flex justify-content-end">
            <link-button-primary asp-controller="Messaging" asp-action="NewConversation" asp-route-toLinkId="@Model.CurrentPatientLinkId" class="extend ms-auto me-2" small outline>
                <partial name="~/Views/Shared/_NewMessageIcon.cshtml" />
                <span class="extend-shrinkable">Message Patient</span>
            </link-button-primary>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <p class="mb-1"><span class="fw-bold text-nowrap">Name: </span> <a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@Model.CurrentPatientId">@Model.CurrentPatientFullNameReverse</a></p>
            <p class="mb-1"><span class="fw-bold text-nowrap">Birthdate: </span> @string.Format("{0:MM/dd/yyyy}", Model.CurrentPatientDOB)</p>
            <p class="mb-1"><span class="fw-bold text-nowrap">Age: </span> @Model.CurrentPatientAge</p>
        </div>
        <div class="col-md-6">
            <p class="mb-1"><span class="fw-bold text-nowrap">Patient ID: </span> #@Model.CurrentPatientId.ToString("D6")</p>
            <p class="mb-1"><span class="fw-bold text-nowrap">SSN: </span> <span class="text-muted">XXX-XX-</span>@Model.CurrentPatientSSN</p>
            <p class="mb-1"><span class="fw-bold text-nowrap">Patient since: </span> @string.Format("{0:MM/dd/yyyy}", Model.CurrentPatientCreatedOn)</p>
        </div>
    </div>
    <hr>
</section>