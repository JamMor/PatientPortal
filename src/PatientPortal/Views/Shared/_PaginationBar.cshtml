@model PaginationBarModel

@{
    var queryRoutes = Model.Routes;
}

@if(Model.Paging.TotalPages() > 1)
{
    <nav aria-label="Result Pages Nav">
        <ul class="pagination justify-content-center">

            @if(Model.Paging.StartPage() > 1)
            {
                <li class="page-item">
                    <a class='page-link @(Model.Paging.CurrentPage == Model.Paging.TotalPages() ? "disabled" : "")' 
                    data-bs-toggle="tooltip" data-bs-placement="left" title="1"
                    asp-all-route-data="queryRoutes"
                    asp-route-CurrentPage="1">
                        &laquo;
                    </a>
                </li>
            }
            @if(Model.Paging.StartPage() > 2)
            {
                <li class="page-item disabled">
                    <a class="page-link">
                        ...
                    </a>
                </li>
            }
            <li class='page-item @(Model.Paging.CurrentPage > 1 ? "" : "disabled")'>
                <a class="page-link" asp-all-route-data="queryRoutes"
                asp-route-CurrentPage="@(Model.Paging.CurrentPage-1)">
                    Previous
                </a>
            </li>
            
            @for(int i = Model.Paging.StartPage(); 
                i <= Model.Paging.TotalPages() && i < Model.Paging.MaxPageLinksPerPage + Model.Paging.StartPage(); 
                i++)
            {
                if(i == Model.Paging.CurrentPage)
                {
                    <li class="page-item fw-bold"><span class="page-link disabled">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-all-route-data="queryRoutes"
                        asp-route-CurrentPage="@i">
                            @i
                        </a>
                    </li>
                }
            }

            <li class='page-item @(Model.Paging.CurrentPage < Model.Paging.TotalPages() ? "" : "disabled")'>
                <a class="page-link" asp-all-route-data="queryRoutes"
                asp-route-CurrentPage="@(Model.Paging.CurrentPage+1)">
                    Next
                </a>
            </li>

            @if(Model.Paging.StartPage() + Model.Paging.MaxPageLinksPerPage < Model.Paging.TotalPages())
            {
                <li class="page-item disabled">
                    <a class="page-link">
                        ...
                    </a>
                </li>
            }
            @if(Model.Paging.StartPage() + Model.Paging.MaxPageLinksPerPage - 1 < Model.Paging.TotalPages())
            {
                <li class="page-item">
                    <a class='page-link @(Model.Paging.CurrentPage == Model.Paging.TotalPages() ? "disabled" : "")' 
                    data-bs-toggle="tooltip" data-bs-placement="right" title="@Model.Paging.TotalPages()"
                    asp-all-route-data="queryRoutes"
                    asp-route-CurrentPage="@Model.Paging.TotalPages()">
                        &raquo;
                    </a>
                </li>
            }
        </ul>
    </nav>
}