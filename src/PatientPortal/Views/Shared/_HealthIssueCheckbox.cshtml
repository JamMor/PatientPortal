@model HealthIssueCheckbox

<div class="form-check">
    <input class="form-check-input" type="checkbox" asp-for="Selected">
    <label class="form-check-label" asp-for="Selected">@Model.ShortDescription</label>
    <input type="hidden" asp-for="HealthIssueId">
    <input type="hidden" asp-for="ShortDescription">
</div>
