@model StaffManagerView

@{
    Dictionary<string, string> QueryRoutes() => Model.Query.ToRouteDict();
}


<div class="d-flex align-items-center gap-1">
    <h2 class="my-0 me-auto fs-5 fw-semibold">
        Staff
        <span class="badge align-middle hue-primary and-dimmed on-bg text-dark">
            @Model.Query.Paging.ResultsCount
        </span>
    </h2>
    <div class="dropdown">
        <button-secondary small outline class="dropdown-toggle" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button-secondary>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Staff" asp-action="StaffManager" 
                    asp-all-route-data="QueryRoutes()"
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <link-button-primary asp-controller="Staff" asp-action="StaffAdd" class="extend" small outline>
        <span>+</span>
        <span class="extend-shrinkable">Add Staff</span>
    </link-button-primary>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Sortable column links — active column reverses direction, new column defaults to descending *@
            @foreach (var column in Model.Query.SortableColumns)
            {
                <th>
                    <a class="@(Model.Query.Sort.IsSortedBy(column) ? "sort-active" : "")"
                        asp-controller="Staff" asp-action="StaffManager"
                        asp-all-route-data="QueryRoutes()"
                        asp-route-SortOrder="@Model.Query.Sort.GetSortOrderForLink(column)">
                        <span class="d-flex text-nowrap gap-2 @(Model.Query.Sort.IsAscending(column) ? "sort-invert" : "")">
                            @column.DisplayName
                            <partial name="_CaretDownIcon" />
                        </span>
                    </a>
                </th>
            }
            <th class="align-middle">Patients</th>
            <th class="align-middle d-none d-sm-table-cell">Registered</th>
        </tr>
    </thead>
    <tbody>
        @{
            if(Model.Results.Staff.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No staff to display.</td>
                </tr>
            }
        }
        @{
            int i = 1;
            foreach (StaffResult staffmember in Model.Results.Staff)
            {
                <tr>
                    <td class="text-muted">@Model.Query.Paging.RowNumber(i)</td>
                    <td><a asp-controller="Staff" asp-action="StaffInfo" asp-route-staffId="@staffmember.StaffId">@staffmember.FullName</a></td>
                    <td>@staffmember.Role</td>
                    <td>#@staffmember.StaffId.ToString("D5")</td>
                    <td>@staffmember.PatientCount</td>
                    <td class="small d-none d-sm-table-cell">
                        <span class="text-nowrap">@staffmember.CreatedAt.ToString("M/d/yyyy")</span>
                        <span class="text-nowrap">@staffmember.CreatedAt.ToString("h:mm:ss\u00a0tt")</span>
                    </td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>