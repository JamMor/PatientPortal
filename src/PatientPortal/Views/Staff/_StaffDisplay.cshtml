@model StaffManagerView

@{
    var search = Context.Request.Query
        .Where(q => q.Key != "CurrentPage")
        .ToDictionary(q => q.Key, q => q.Value.ToString());
}

<div class="d-flex">
    <h4 class="my-0 me-auto">Staff <span class="badge hue-primary and-dimmed on-bg text-dark">@Model.PaginationSettings.ResultsCount</span>:</h4>
    <div class="dropdown">
        <button class="btn btn-sm dropdown-toggle hue-secondary on-btn-outline" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Staff" asp-action="StaffManager" 
                    asp-all-route-data="search"
                    asp-route-SortOrder="@Model.PaginationSettings.SortOrder" 
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <a asp-controller="Staff" asp-action="StaffAdd" class="btn btn-sm extend hue-primary and-dimmed on-btn-outline">+<span>  Add Staff</span></a>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Already selected sort column link is changed to reverse direction *@
            @{
                string[] sortOptions = {"Last Name", "Role", "Staff Id"};
                foreach(string sortOption in sortOptions)
                {
                string sortField = sortOption.Replace(" ", "");
                <th>
                    <a asp-controller="Staff" asp-action="StaffManager" 
                    asp-all-route-data="search"
                    asp-route-ResultsPerPage="@Model.PaginationSettings.ResultsPerPage"
                    asp-route-SortOrder='@(sortField)_@(Model.PaginationSettings.SortColumn() == sortField ? Model.PaginationSettings.Reverse() : "desc")'>
                        @sortOption
                    </a>
                </th>

                }
            }
            <th class="align-middle">Patients</th>
            <th class="align-middle">Registered</th>
        </tr>
    </thead>
    <tbody>
        @{
            if(Model.SearchResults.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No staff to display.</td>
                </tr>
            }
        }
        @{
            int i = 1;
            foreach (StaffResult staffmember in Model.SearchResults)
            {
                <tr>
                    <td class="text-muted">@(Model.PaginationSettings.ResultsPerPage*(Model.PaginationSettings.CurrentPage - 1) + i)</td>
                    <td><a asp-controller="Staff" asp-action="StaffInfo" asp-route-staffId="@staffmember.StaffId">@staffmember.FullName</a></td>
                    <td>@staffmember.Role</td>
                    <td>#@staffmember.StaffId.ToString("D5")</td>
                    <td>@staffmember.PatientCount</td>
                    <td>@staffmember.CreatedAt</td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>