@model StaffManagerView

@{
    var queryRoutes = Context.Request.Query
        .Where(q => q.Key != "CurrentPage")
        .ToDictionary(q => q.Key, q => q.Value.ToString());

    var sortableTableColumns = new[]
    {
        (Label: "Last Name", Field: "LastName"),
        (Label: "Role",      Field: "Role"),
        (Label: "Staff Id",  Field: "StaffId")
    };
}

<div class="d-flex">
    <h4 class="my-0 me-auto">Staff <span class="badge hue-primary and-dimmed on-bg text-dark">@Model.ResultsCount</span>:</h4>
    <div class="dropdown">
        <button class="btn btn-sm dropdown-toggle hue-secondary on-btn-outline" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Staff" asp-action="StaffManager" 
                    asp-all-route-data="queryRoutes"
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <a asp-controller="Staff" asp-action="StaffAdd" class="btn btn-sm extend hue-primary and-dimmed on-btn-outline">
        +
        <span class="extend-shrinkable">Add Staff</span></a>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Sortable column links — active column reverses direction, new column defaults to descending *@
            @foreach (var col in sortableTableColumns)
            {
                var isActive = col.Field == Model.PaginationSettings.SortColumn();
                var isAsc = isActive && Model.PaginationSettings.SortDirection() == "asc";
                <th>
                    <a class="@(isActive ? "sort-active" : "")"
                        asp-controller="Staff" asp-action="StaffManager"
                        asp-all-route-data="queryRoutes"
                        asp-route-SortOrder="@Model.PaginationSettings.GetToggledSortOrder(col.Field)">
                        <span class="d-flex text-nowrap gap-1 @(isAsc ? "sort-invert" : "")">
                            @col.Label 
                            <partial name="_CaretDownIcon" />
                        </span>
                    </a>
                </th>
            }
            <th class="align-middle">Patients</th>
            <th class="align-middle d-none d-sm-table-cell">Registered</th>
        </tr>
    </thead>
    <tbody>
        @{
            if(Model.SearchResults.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No staff to display.</td>
                </tr>
            }
        }
        @{
            int i = 1;
            foreach (StaffResult staffmember in Model.SearchResults)
            {
                <tr>
                    <td class="text-muted">@Model.PaginationSettings.RowNumber(i)</td>
                    <td><a asp-controller="Staff" asp-action="StaffInfo" asp-route-staffId="@staffmember.StaffId">@staffmember.FullName</a></td>
                    <td>@staffmember.Role</td>
                    <td>#@staffmember.StaffId.ToString("D5")</td>
                    <td>@staffmember.PatientCount</td>
                    <td class="small d-none d-sm-table-cell">
                        <span class="text-nowrap">@staffmember.CreatedAt.ToString("M/d/yyyy")</span>
                        <span class="text-nowrap">@staffmember.CreatedAt.ToString("h:mm:ss\u00a0tt")</span>
                    </td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>