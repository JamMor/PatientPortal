@model StaffInfoViewModel

<div class="d-flex mt-3">
    <a asp-controller="Messaging" asp-action="NewConversation" asp-route-toLinkId="@Model.MessagingLinkId" class="btn btn-outline-primary btn-sm extend ml-auto mr-2"><i class="far fa-file-alt"></i><span>&nbsp; Message Staffmember</span></a>
</div>
<table class="table">
    <tbody>
        <tr>
            <th>Name</th>
            <td>@Model.FullName()</td>
        </tr>
        <tr>
            <th>Role</th>
            <td>@Model.Role</td>
        </tr>
        <tr>
            <th>Patients</th>
            <td>@Model.PatientCount</td>
        </tr>
        <tr>
            <th>Added to System</th>
            <td>@Model.CreatedAt</td>
        </tr>
        <tr>
            <th>Last Updated</th>
            <td>@Model.UpdatedAt</td>
        </tr>
    </tbody>
</table>
<form class="text-right" asp-controller="Staff" asp-action="StaffDelete" asp-route-staffId="@Model.StaffId">
    <button class="btn btn-sm btn-outline-danger" href="#">Delete Staff</button>
</form>