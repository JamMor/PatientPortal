@model StaffInfoViewModel

<div class="d-flex mt-3">
    <link-button-primary asp-controller="Messaging" asp-action="NewConversation" asp-route-toLinkId="@Model.MessagingLinkId" class="extend ms-auto me-2" small outline>
        <partial name="~/Views/Shared/_NewMessageIcon.cshtml" />
        <span class="extend-shrinkable">&nbsp; Message Staffmember</span>
    </link-button-primary>
</div>
<table class="table">
    <tbody>
        <tr>
            <th>Name</th>
            <td>@Model.FullName()</td>
        </tr>
        <tr>
            <th>Role</th>
            <td>@Model.Role</td>
        </tr>
        <tr>
            <th>Patients</th>
            <td>@Model.PatientCount</td>
        </tr>
        <tr>
            <th>Added to System</th>
            <td>@Model.CreatedAt</td>
        </tr>
        <tr>
            <th>Last Updated</th>
            <td>@Model.UpdatedAt</td>
        </tr>
    </tbody>
</table>
<form class="text-end" asp-controller="Staff" asp-action="StaffDelete" asp-route-staffId="@Model.StaffId">
    <button-danger small outline type="submit">Delete Staff</button-danger>
</form>