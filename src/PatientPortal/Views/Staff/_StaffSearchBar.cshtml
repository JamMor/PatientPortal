@model StaffManagerView

<form class="mt-3" asp-controller="Staff" asp-action="StaffManager" method="get">
    <div class="row justify-content-around align-items-center flex-wrap">
        <div class="mb-3 col-auto">
            <label class="form-label" asp-for="SearchBar.SearchStaffId"></label>
            <input class="form-control" asp-for="SearchBar.SearchStaffId">
            <span class="text-danger" asp-validation-for="SearchBar.SearchStaffId"></span>
        </div>
        <div class="mb-3 col-auto">
            <label class="form-label" asp-for="SearchBar.SearchFirstName"></label>
            <input class="form-control" asp-for="SearchBar.SearchFirstName">
            <span class="text-danger" asp-validation-for="SearchBar.SearchFirstName"></span>
        </div>
        <div class="mb-3 col-auto">
            <label class="form-label" asp-for="SearchBar.SearchLastName"></label>
            <input class="form-control" asp-for="SearchBar.SearchLastName">
            <span class="text-danger" asp-validation-for="SearchBar.SearchLastName"></span>
        </div>
        <div class="mb-3 col-auto">
            <label class="form-label" asp-for="SearchBar.SearchRole"></label>
            <input class="form-control" asp-for="SearchBar.SearchRole">
            <span class="text-danger" asp-validation-for="SearchBar.SearchRole"></span>
        </div>
    </div>
    <input type="hidden" name="SortOrder" value="@Model.PaginationSettings.SortOrder">
    <input type="hidden" name="ResultsPerPage" value="@Model.PaginationSettings.ResultsPerPage">
    <div class="text-center">
        <button class="btn m-1 hue-primary and-dimmed hover-lighten on-btn">Search</button>
        <a class="btn m-1 hue-secondary on-btn-outline" asp-controller="Staff" asp-action="StaffManager">Clear</a>
    </div>
</form>