@model StaffSearchForm

<form class="mt-3" asp-controller="Staff" asp-action="StaffManager" method="get">
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 gx-3">
        <div class="col">
            <form-field asp-for="StaffId"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="FirstName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="LastName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="Role"></form-field>
        </div>
    </div>
    <input type="hidden" asp-for="SortOrder">
    <input type="hidden" asp-for="ResultsPerPage">
    <div class="text-center">
        <button-primary type="submit" class="m-1">Search</button-primary>
        <link-button-secondary outline class="m-1" asp-controller="Staff" asp-action="StaffManager">Clear</link-button-secondary>
    </div>
</form>