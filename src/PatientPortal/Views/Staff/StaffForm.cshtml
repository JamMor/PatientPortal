@model StaffFormView

<h3>New Staffmember: </h3>
<form asp-action="StaffCreate" asp-controller="Staff" method="post">
    <div class="form-group">
        <label class="form-label" asp-for="FirstName"></label>
        <span class="text-danger" asp-validation-for="FirstName"></span>
        <input class="form-control" asp-for="FirstName">
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="LastName"></label>
        <span class="text-danger" asp-validation-for="LastName"></span>
        <input class="form-control" asp-for="LastName">
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Role"></label>
        <span class="text-danger" asp-validation-for="Role"></span>
        <select class="form-control" asp-for="Role">
            <option value="Chief of Medicine">Chief of Medicine</option>
            <option value="MD">MD</option>
            <option value="NP">NP</option>
            <option value="RN">RN</option>
            <option value="LN">LN</option>
            <option value="Lab Technician">Lab Technician</option>
            <option value="Front Office">Front Office</option>
            <option value="Billing">Billing</option>
            <option value="Scheduling">Scheduling</option>
            <option value="Admin">Admin</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="StaffUsername"></label>
        <span class="text-danger" asp-validation-for="StaffUsername"></span>
        <input class="form-control" asp-for="StaffUsername">
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Password"></label>
        <span class="text-danger" asp-validation-for="Password"></span>
        <input class="form-control" asp-for="Password">
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="ConfirmPassword"></label>
        <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
        <input class="form-control" asp-for="ConfirmPassword">
    </div>
    <div asp-validation-summary="ModelOnly"></div>
    <button class="btn btn-info">Add to Staff</button>
</form>