@model VisitForm

@{ int patientId = Convert.ToInt32(ViewContext.RouteData.Values["patientId"]); }
@await Component.InvokeAsync("PatientInfoHeader", new { patientId = patientId })

<h3>New Visit: </h3>
<form asp-action="VisitCreate" asp-controller="Visit" asp-route-patientId="@patientId" method="post">
    <form-field asp-for="DateOfVisit"></form-field>
    <form-field asp-for="Comment" type="textarea"></form-field>
    <div class="form-group">
        @for(int i = 0; i < Model.HealthIssues.Count; i++)
        {
            <partial name="~/Views/Shared/_HealthIssueCheckbox.cshtml" for="HealthIssues[i]" />
        }
    </div>
    <div class="form-group">
        <label class="form-label" for="Upload">Related Documents</label>
        <input class="form-control" type="file" name="Upload" id="Upload">
    </div>
    <div asp-validation-summary="ModelOnly"></div>
    <button class="btn btn-info">Add Visit Note</button>
    <a class="btn btn-outline-danger" asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patientId">Cancel</a>
</form>