@model VisitFormView

<partial name="~/Views/Shared/_PatientInfoHeader.cshtml" for="Patient"/>

<h3>New Visit: </h3>
<form asp-action="VisitCreate" asp-controller="Visit" asp-route-patientId="@Model.Patient.CurrentPatientId" method="post">
    <div class="form-group">
        <label class="form-label" asp-for="VisitForm.DateOfVisit"></label>
        <span class="text-danger" asp-validation-for="VisitForm.DateOfVisit"></span>
        <input class="form-control" asp-for="VisitForm.DateOfVisit">
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="VisitForm.Comment"></label>
        <span class="text-danger" asp-validation-for="VisitForm.Comment"></span>
        <textarea class="form-control" asp-for="VisitForm.Comment"></textarea>
    </div>
    <div class="form-group">
        @for(int i = 0; i < Model.VisitForm.HealthIssues.Count; i++)
        {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="VisitForm.HealthIssues[i].Selected">
            <label class="form-check-label" asp-for="VisitForm.HealthIssues[i].Selected">
                @Model.VisitForm.HealthIssues[i].ShortDescription
            </label>
            <input class="form-check-input" type="hidden" asp-for="VisitForm.HealthIssues[i].HealthIssueId">
            <input class="form-check-input" type="hidden" asp-for="VisitForm.HealthIssues[i].ShortDescription">
        </div>
        }
    </div>
    <div class="form-group">
        <label class="form-label" for="Upload"></label>
        <input class="form-control"type="file" name="Upload" id="Upload">
    </div>
    <button class="btn btn-info">Add Visit Note</button>
    <a class="btn btn-outline-danger" asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@Model.Patient.CurrentPatientId">Cancel</a>
</form>