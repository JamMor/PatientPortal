@model PatientSearchForm

<form class="mt-3" asp-controller="Patients" asp-action="PatientManager" method="get">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 gx-3">
        <div class="col">
            <form-field asp-for="PatientId"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="FirstName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="LastName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="Birthdate"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="SSN"></form-field>
        </div>
    </div>
    <div class="mb-3 d-flex justify-content-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="OnlyPatientsUnderCare">
            <label class="form-check-label" asp-for="OnlyPatientsUnderCare"></label>
        </div>
    </div>
    <input type="hidden" asp-for="SortOrder">
    <input type="hidden" asp-for="ResultsPerPage">
    <div class="text-center">
        <button-primary type="submit" class="m-1">Search</button-primary>
        <link-button-secondary outline class="m-1" asp-controller="Patients" asp-action="PatientManager">Clear</link-button-secondary>
    </div>
</form>