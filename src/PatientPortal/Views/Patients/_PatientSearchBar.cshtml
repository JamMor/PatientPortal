@model PatientManagerView

<form class="mt-3" asp-controller="Patients" asp-action="PatientManager" method="get">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 gx-3">
        <div class="col">
            <form-field asp-for="SearchBar.SearchPatientId"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="SearchBar.SearchFirstName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="SearchBar.SearchLastName"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="SearchBar.SearchBirthdate"></form-field>
        </div>
        <div class="col">
            <form-field asp-for="SearchBar.SearchSSN"></form-field>
        </div>
    </div>
    <div class="mb-3 d-flex justify-content-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="SearchBar.SearchPatientsUnderCare">
            <label class="form-check-label" asp-for="SearchBar.SearchPatientsUnderCare"></label>
        </div>
    </div>
    <input type="hidden" name="SortOrder" value="@Model.PaginationSettings.SortOrder">
    <input type="hidden" name="ResultsPerPage" value="@Model.PaginationSettings.ResultsPerPage">
    <div class="text-center">
        <button class="btn m-1 hue-primary and-dimmed hover-lighten on-btn">Search</button>
        <a class="btn m-1 hue-secondary on-btn-outline" asp-controller="Patients" asp-action="PatientManager">Clear</a>
    </div>
</form>