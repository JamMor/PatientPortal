@model PatientManagerView

@{
var search = new Dictionary<string, string>
            {
                {"SearchPatientId",@Model.SearchBar.SearchPatientId.ToString()},
                {"SearchFirstName",@Model.SearchBar.SearchFirstName},
                {"SearchLastName",@Model.SearchBar.SearchLastName},
                {"SearchBirthdate",@Model.SearchBar.SearchBirthdate.ToString()},
                {"SearchSSN", @Model.SearchBar.SearchSSN},
                {"SortOrder",@Model.PaginationSettings.SortOrder},
                {"ResultsPerPage",@Model.PaginationSettings.ResultsPerPage.ToString()}
            };


}

@if(@Model.PaginationSettings.TotalPages() > 1)
{
    <nav aria-label="Result Pages Nav">
        <ul class="pagination justify-content-center">

            @if(@Model.PaginationSettings.StartPage() > 1)
            {
                <li class="page-item">
                    <a class='page-link @(@Model.PaginationSettings.CurrentPage == @Model.PaginationSettings.TotalPages() ? "disabled" : "")' 
                    data-toggle="tooltip" data-placement="left" title="1"
                    asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-CurrentPage="1">
                        &laquo;
                    </a>
                </li>
            }
            @if(@Model.PaginationSettings.StartPage() > 2)
            {
                <li class="page-item disabled">
                    <a class="page-link">
                        ...
                    </a>
                </li>
            }
            <li class='page-item @(@Model.PaginationSettings.CurrentPage > 1 ? "" : "disabled")'>
                <a class="page-link" asp-controller="Patients" asp-action="PatientManager" 
                asp-all-route-data="search"
                asp-route-CurrentPage="@(@Model.PaginationSettings.CurrentPage-1)">
                    Previous
                </a>
            </li>
            
            @for(int i = @Model.PaginationSettings.StartPage(); 
                i <= @Model.PaginationSettings.TotalPages() && i < @Model.PaginationSettings.MaxPageLinksPerPage + @Model.PaginationSettings.StartPage(); 
                i++)
            {
                if(i == @Model.PaginationSettings.CurrentPage)
                {
                    <li class="page-item font-weight-bold"><span class="page-link disabled">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-controller="Patients" asp-action="PatientManager" 
                        asp-all-route-data="search"
                        asp-route-CurrentPage="@i">
                            @i
                        </a>
                    </li>
                }
            }

            <li class='page-item @(@Model.PaginationSettings.CurrentPage < @Model.PaginationSettings.TotalPages() ? "" : "disabled")'>
                <a class="page-link" asp-controller="Patients" asp-action="PatientManager" 
                asp-all-route-data="search"
                asp-route-CurrentPage="@(@Model.PaginationSettings.CurrentPage+1)">
                    Next
                </a>
            </li>

            @if(@Model.PaginationSettings.StartPage() + @Model.PaginationSettings.MaxPageLinksPerPage < @Model.PaginationSettings.TotalPages())
            {
                <li class="page-item disabled">
                    <a class="page-link">
                        ...
                    </a>
                </li>
            }
            @if(@Model.PaginationSettings.StartPage() + @Model.PaginationSettings.MaxPageLinksPerPage - 1 < @Model.PaginationSettings.TotalPages())
            {
                <li class="page-item">
                    <a class='page-link @(@Model.PaginationSettings.CurrentPage == @Model.PaginationSettings.TotalPages() ? "disabled" : "")' 
                    data-toggle="tooltip" data-placement="right" title="@Model.PaginationSettings.TotalPages()"
                    asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-CurrentPage="@Model.PaginationSettings.TotalPages()">
                        &raquo;
                    </a>
                </li>
            }
        </ul>
    </nav>
}