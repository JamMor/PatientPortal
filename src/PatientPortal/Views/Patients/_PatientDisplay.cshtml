@model PatientManagerView

@{
    var search = Context.Request.Query
        .Where(q => q.Key != "CurrentPage")
        .ToDictionary(q => q.Key, q => q.Value.ToString());
}

<div class="d-flex">
    <h4 class="my-0 mr-auto">Patients <span class="badge badge-secondary">@Model.PaginationSettings.ResultsCount</span>:</h4>
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-SortOrder="@Model.PaginationSettings.SortOrder" 
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <a asp-controller="Patients" asp-action="PatientCreate" class="btn btn-outline-primary btn-sm extend">+<span>  Add Patient</span></a>
</div>
<table class="table">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Already selected sort column link is changed to reverse direction *@
            @{
                string[] sortOptions = {"Last Name", "DOB", "Patient Id"};
                foreach(string sortOption in sortOptions)
                {
                string sortField = sortOption.Replace(" ", "");
                <th>
                    <a asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-ResultsPerPage="@Model.PaginationSettings.ResultsPerPage"
                    asp-route-SortOrder='@(sortField)_@(Model.PaginationSettings.SortColumn() == @sortField ? Model.PaginationSettings.Reverse() : "desc")'>
                        @sortOption
                    </a>
                </th>

                }
            }
            <th class="align-middle">SSN</th>
        </tr>
    </thead>
    <tbody>
        @{
            if(@Model.SearchResults.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No patients to display.</td>
                </tr>
            }
        }
        @{
            int i = 1;
            foreach (PatientResult patient in @Model.SearchResults)
            {
                <tr>
                    <td class="text-muted">@(Model.PaginationSettings.ResultsPerPage*(Model.PaginationSettings.CurrentPage - 1) + i)</td>
                    <td><a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patient.PatientId">@patient.LastName, @patient.FirstName</a></td>
                    <td>@string.Format("{0:MM/dd/yyyy}", @patient.DOB) <span class="ml-1 text-muted">(@patient.Age)</span></td>
                    <td>#@patient.PatientId.ToString("D6")</td>
                    <td>@patient.Last4SSN</td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>