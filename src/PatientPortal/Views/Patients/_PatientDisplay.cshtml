@model PatientManagerView

@{
    var queryRoutes = Context.Request.Query
        .Where(q => q.Key != "CurrentPage")
        .ToDictionary(q => q.Key, q => q.Value.ToString());

    var sortableTableColumns = new[]
    {
        (Label: "Last Name",  Field: "LastName"),
        (Label: "DOB",        Field: "DOB"),
        (Label: "Patient Id", Field: "PatientId")
    };
}

<div class="d-flex align-items-center gap-1">
    <h4 class="my-0 me-auto">
        <span>
            Patients 
            <span class="badge hue-primary and-dimmed on-bg text-dark">
                @Model.ResultsCount
            </span>
            :
        </span>
    </h4>
    <div class="dropdown">
        <button-secondary small outline class="dropdown-toggle" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button-secondary>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="queryRoutes"
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <link-button-primary asp-controller="Patients" asp-action="PatientCreate" class="extend" small outline>
        <span>+</span>
        <span class="extend-shrinkable">Add Patient</span>
    </link-button-primary>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Sortable column links — active column reverses direction, new column defaults to descending *@
            @foreach (var col in sortableTableColumns)
            {
                var isActive = col.Field == Model.PaginationSettings.SortColumn();
                var isAsc = isActive && Model.PaginationSettings.SortDirection() == "asc";
                <th>
                    <a class="@(isActive ? "sort-active" : "")"
                        asp-controller="Patients" asp-action="PatientManager"
                        asp-all-route-data="queryRoutes"
                        asp-route-SortOrder="@Model.PaginationSettings.GetToggledSortOrder(col.Field)">
                        <span class="d-flex text-nowrap gap-2 @(isAsc ? "sort-invert" : "")">
                            @col.Label 
                            <partial name="_CaretDownIcon" />
                        </span>
                    </a>
                </th>
            }
            <th class="align-middle">SSN</th>
        </tr>
    </thead>
    <tbody>
        @{
            if(Model.SearchResults.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No patients to display.</td>
                </tr>
            }
        }
        @{
            int i = 1;
            foreach (PatientResult patient in Model.SearchResults)
            {
                <tr>
                    <td class="text-muted">@Model.PaginationSettings.RowNumber(i)</td>
                    <td><a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patient.PatientId">@patient.LastName, @patient.FirstName</a></td>
                    <td>@string.Format("{0:MM/dd/yyyy}", patient.DOB) <span class="ms-1 text-muted">(@patient.Age)</span></td>
                    <td>#@patient.PatientId.ToString("D6")</td>
                    <td>@patient.Last4SSN</td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>