@model PatientFormView

<h3>New Patient: </h3>
<form class="row" asp-action="PatientCreate" asp-controller="Patients" method="post">
    <div class="col-md-6">
        <form-field asp-for="FirstName"></form-field>
        <form-field asp-for="LastName"></form-field>
        <form-field asp-for="DOB"></form-field>
        <form-field asp-for="Last4SSN"></form-field>
    </div>
    <div class="col-md-6">
        <h5 class="text-muted">Contact Info (optional)</h5>
        <form-field asp-for="PhoneNumber"></form-field>
        <form-field asp-for="Email"></form-field>
        <hr>
        <span class="text-danger" asp-validation-for="Address"></span>
        <form-field asp-for="Address.StreetAddress"></form-field>
        <form-field asp-for="Address.City"></form-field>
        <form-field asp-for="Address.State"></form-field>
        <form-field asp-for="Address.ZipCode"></form-field>
    </div>
    <div class="col" asp-validation-summary="ModelOnly"></div>
    <div class="col d-flex justify-content-center mt-3">
        <button class="btn btn-info">Create Patient</button>
    </div>
</form>