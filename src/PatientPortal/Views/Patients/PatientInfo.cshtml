@using PatientPortal.Extensions
@model PatientInfoViewModel

<partial name="~/Views/Shared/_PatientInfoHeader.cshtml" for="PatientHeader"/>


<dl class="patient-dl">
    <div>
        <dt>Medical Team</dt>
        <dd>
            <ul class="list-group list-group-flush">
                @foreach (StaffInfo staff in Model.MedicalTeam)
                {
                    <li class="list-group-item d-flex">
                        <p class="my-0 me-auto">@staff.FullName, @staff.Role</p> 
                        @if(staff.StaffId == User.GetStaffId())
                        {
                        <form asp-controller="Patients" asp-action="MedicalTeamLeave" asp-route-patientId="@Model.PatientId">
                            <button-secondary small outline type="submit">Remove</button-secondary>
                        </form>
                        }
                    </li>
                }
                @if(!Model.MedicalTeam.Any(staff => staff.StaffId == User.GetStaffId()))
                {
                    <li class="list-group-item text-end">
                        <form asp-controller="Patients" asp-action="MedicalTeamJoin" asp-route-patientId="@Model.PatientId">
                            <button-primary small outline type="submit">Join</button-primary>
                        </form>
                    </li>
                }
            </ul>
        </dd>
    </div>
    <div>
        <dt>Health Issues</dt>
        <dd>
            <ul class="list-group list-group-flush">
                @foreach (HealthIssueInfo issue in Model.HealthIssues)
                {
                    <li class="card list-group-item">
                        <h6 class="card-header collapsed text-link" data-bs-toggle="collapse" data-bs-target="#issue-detail-@issue.HealthIssueId" aria-expanded="false" aria-controls="issue-detail-@issue.HealthIssueId">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@issue.ShortDescription</span>
                                <partial name="_ToggleIcon.cshtml" />
                            </div>
                        </h6>
                        <div id="issue-detail-@issue.HealthIssueId" class="collapse">
                            <div class="card-body">
                                <p class="card-text">@issue.LongDescription</p>
                                <p class="card-text">@issue.AssociatedTestResultsCount Related Tests</p>
                                <p class="card-text">@issue.AssociatedVisitsCount Related Visits</p>
                            </div>
                            <div class="card-footer d-flex align-items-center">
                                <span>First Reported: @issue.CreatedAt</span>
                                <form class="ms-auto" asp-controller="HealthIssue" asp-action="IssueDelete" asp-route-patientId="@Model.PatientId" asp-route-issueId="@issue.HealthIssueId">
                                    <button-danger small outline type="submit">Delete</button-danger>
                                </form>
                            </div>
                        </div>
                    </li>
                }
                <li class="list-group-item text-end">
                    <link-button-primary small outline asp-controller="HealthIssue" asp-action="HealthIssueAdd" asp-route-patientId="@Model.PatientId">
                        Add Health Issue
                    </link-button-primary>
                </li>
            </ul>
        </dd>
    </div>
    <div>
        <dt>Visits</dt>
        <dd>
            <ul class="list-group list-group-flush">
                @foreach (VisitInfo visit in Model.Visits)
                {
                    <li class="card list-group-item">
                        <h6 class="card-header collapsed text-link" data-bs-toggle="collapse" data-bs-target="#visit-detail-@visit.VisitId" aria-expanded="false" aria-controls="visit-detail-@visit.VisitId">
                            <div class="d-flex">
                                <span class="flex-grow-1">@visit.DateOfVisit</span>
                                <partial name="_ToggleIcon.cshtml" />
                            </div>
                        </h6>
                        <div id="visit-detail-@visit.VisitId" class="collapse">
                            <div class="card-body">
                                <p class="card-text">@visit.Comment</p>
                            </div>
                            <div class="card-footer d-flex align-items-center">
                                <p class="mb-0">@visit.CreatedBy</p>
                                <form class="ms-auto" asp-controller="Visit" asp-action="VisitDelete" asp-route-patientId="@Model.PatientId" asp-route-visitId="@visit.VisitId">
                                    <button-danger small outline type="submit">Delete</button-danger>
                                </form>
                            </div>
                        </div>
                    </li>
                }
                <li class="list-group-item text-end">
                    <link-button-primary small outline asp-controller="Visit" asp-action="VisitAdd" asp-route-patientId="@Model.PatientId">
                        Add Visit
                    </link-button-primary>
                </li>
            </ul>
        </dd>
    </div>
    <div>
        <dt>Tests</dt>
        <dd>
            <ul class="list-group list-group-flush">
                @foreach (TestResultInfo test in Model.TestResults)
                {
                    <li class="card list-group-item">
                        <h6 class="card-header collapsed text-link" data-bs-toggle="collapse" data-bs-target="#test-detail-@test.TestResultId" aria-expanded="false" aria-controls="test-detail-@test.TestResultId">
                            <div class="d-flex">
                                <span class="flex-grow-1">@test.Type - @test.CreatedAt</span>
                                <partial name="_ToggleIcon.cshtml" />
                            </div>
                        </h6>
                        <div id="test-detail-@test.TestResultId" class="collapse">
                            <div class="card-body">
                                <p class="card-text">@test.Comment</p>
                            </div>
                            <div class="card-footer d-flex align-items-center">
                                <p class="mb-0">@test.CreatedBy</p>
                                <form class="ms-auto" asp-controller="TestResult" asp-action="TestResultDelete" asp-route-patientId="@Model.PatientId" asp-route-testId="@test.TestResultId">
                                    <button-danger small outline type="submit">Delete</button-danger>
                                </form>
                            </div>
                        </div>
                    </li>
                }
                <li class="list-group-item text-end">
                    <link-button-primary small outline asp-controller="TestResult" asp-action="TestResultAdd" asp-route-patientId="@Model.PatientId">
                        Add Test
                    </link-button-primary>
                </li>
            </ul>
        </dd>
    </div>
    <div>
        <dt>Added to System</dt>
        <dd>@Model.CreatedAt</dd>
    </div>
    <div>
        <dt>Last Updated</dt>
        <dd>@Model.UpdatedAt</dd>
    </div>
</dl>
<form class="text-end" asp-controller="Patients" asp-action="PatientDelete" asp-route-patientId="@Model.PatientId">
    <button-danger small outline type="submit">Delete Patient</button-danger>
</form>