@model List<Staff>

<div>
    @if(Model.Count == 0)
    {
    <div class="container m-3">
        <form class="d-flex" asp-controller="Test" asp-action="TestCreate">
            <button class="mx-1 btn btn-sm btn-warning">Create Picard</button>
        </form>
    </div>
    }
    else
    {
    <div class="container m-3">
        <form class="d-flex" asp-controller="Test" asp-action="TestLoginOptions">
            @{
                foreach(Staff staff in Model)
                {
                    <button name="staffId" class="mx-1 btn btn-sm btn-warning" value=@staff.StaffId>Login @staff.FirstName[0] @staff.LastName</button>
                }
            }
        </form>
    </div>
    }
</div>