@model PatientHeaderInfoView

<div class="container p-3 pb-4 shadow bg-light">
    <div class="row">
        <a asp-controller="Messaging" asp-action="NewConversation" asp-route-toLinkId="@Model.CurrentPatientLinkId" class="btn btn-outline-primary btn-sm extend ml-auto mr-2"><i class="far fa-file-alt"></i><span>Message Patient</span></a>
    </div>
    <div class="row">
        <div class="col-md-6">
            <h5><span class="font-weight-bold no-wrap">Name: </span> @Model.CurrentPatientFullNameReverse</h5>
            <h5><span class="font-weight-bold no-wrap">Birthdate: </span> @string.Format("{0:MM/dd/yyyy}", @Model.CurrentPatientDOB)</h5>
            <h5><span class="font-weight-bold no-wrap">Age: </span> @Model.CurrentPatientAge</h5>
        </div>
        <div class="col-md-6">
            <h5><span class="font-weight-bold no-wrap">Patient ID: </span> @Model.CurrentPatientId</h5>
            <h5><span class="font-weight-bold no-wrap">SSN: </span> <span class="text-muted">XXX-XX-</span>@Model.CurrentPatientSSN</h5>
            <h5><span class="font-weight-bold no-wrap">Patient since: </span> @string.Format("{0:MM/dd/yyyy}", @Model.CurrentPatientCreatedOn)</h5>
        </div>
    </div>
</div>
<hr class="mt-6 shadow-sm">