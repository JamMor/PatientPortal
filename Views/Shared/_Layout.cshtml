<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PatientPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://kit.fontawesome.com/bb93b9a982.js" crossorigin="anonymous"></script>
</head>
<body class="bg-light overflow-hidden">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">PatientPortal</a>
                @if(@Context.Session.GetInt32("UserId") != null)
                {
                    <div class="order-0 order-sm-last">
                        <a asp-controller="Messaging" asp-action="Inbox"><i class="fas fa-envelope fa-2x"></i></a>
                    </div>
                }
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    @if(@Context.Session.GetInt32("UserId") != null)
                    {
                        <h6 class="p-2 text-dark">Welcome, @Context.Session.GetString("Name")!</h6>
                    }
                    <ul class="navbar-nav flex-grow-1 order-sm-first">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if(@Context.Session.GetString("Role") == "Admin")
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Staff" asp-action="StaffManager">Staff</a>
                        </li>
                        }
                        @if(@Context.Session.GetString("Role") != null)
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Patients" asp-action="PatientManager">Patients</a>
                        </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                     @if(@Context.Session.GetInt32("UserId") != null)
                    {
                        <form class="p-2" asp-controller="Login" asp-action="Logout">
                            <button class="btn btn-secondary btn-sm">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container p-0 bg-white box-shadow">
        <main class="px-3 pb-3" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-1">
        <div class="container">
            &copy; 2021 - PatientPortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
