@model StaffSearch


<form asp-controller="Staff" asp-action="StaffManagerQuery" method="post">
    <div class="form-row justify-content-around align-items-center flex-wrap">
        <div class="form-group col-auto">
            <input class="form-control" asp-for="SearchStaffId">
            <span class="text-danger" asp-validation-for="SearchStaffId"></span>
            <label class="form-label" asp-for="SearchStaffId"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="SearchFirstName">
            <span class="text-danger" asp-validation-for="SearchFirstName"></span>
            <label class="form-label" asp-for="SearchFirstName"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="SearchLastName">
            <span class="text-danger" asp-validation-for="SearchLastName"></span>
            <label class="form-label" asp-for="SearchLastName"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="SearchRole">
            <span class="text-danger" asp-validation-for="SearchRole"></span>
            <label class="form-label" asp-for="SearchRole"></label>
        </div>
    </div>
    <div class="text-center">
        <button class="btn btn-secondary m-1">Search</button>
        <a class="btn btn-outline-secondary m-1" asp-controller="Staff" asp-action="StaffManager">Clear</a>
    </div>
</form>