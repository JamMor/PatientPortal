@model MessageInboxView

<table class="table">
    <thead>
        <tr>
            <th class="col-2">Members</th>
            <th>Subject</th>
            <th class="col-1">Start Date</th>
            <th class="col-1">Latest Message Date</th>
        </tr>
    </thead>
    <tbody class="accordion" id="conversation-container">
        @foreach (InboxConversation conversation in @Model.Conversations)
        {
            //class='nav-link @(@ViewBag.inbox == "patient" ? "active" : "")'
            <tr data-toggle="collapse" data-target="#messages-@conversation.ConversationId" class='collapsed @(@conversation.UnreadCount() > 0 ? "bg-light font-weight-bold" : "")'>
                <td class="text-truncate td-member">
                    @String.Join(", ", conversation.Participating.Select(p => p.Name))
                </td>
                <td class="text-truncate">@conversation.Subject</td>
                <td>@conversation.DateCreated</td>
                <td>@conversation.DateLastMessage</td>
            </tr>
            <tr id="messages-@conversation.ConversationId" class="collapse" data-parent="#conversation-container">
                <td colspan="4">
                @foreach (InboxMessage message in conversation.Messages)
                {
                    <div class='pl-3 d-flex @(@message.Unread ? "bg-light font-weight-bold" : "")'>
                        <p class="font-weight-bold text-info">@conversation.Participating.SingleOrDefault(p => p.LinkId == message.SenderId).Name:</p>
                        <p class="col-8" colspan="2">@message.MessageText</p>
                        <p class="text-secondary">@message.Sent</p>
                    </div>
                }
                    @* <form class="form-inline" asp-controller="Messaging" asp-action="NewReply" asp-route-conversationId="@conversation.ConversationId" method="post">
                        <div class="form-group">
                            <label for="messagetext-@conversation.ConversationId">Reply:</label>
                            <input type="text" class="form-control" placeholder="Message..." id="messagetext-@conversation.ConversationId" name="messagetext-@conversation.ConversationId">
                        </div>
                        <button class="btn btn-info">Send</button>
                    </form> *@

                    <partial name="_NewReply.cshtml" model="new ReplyView(){ConversationId = @conversation.ConversationId}" />

                </td>
            </tr>
        }
    </tbody>
</table>