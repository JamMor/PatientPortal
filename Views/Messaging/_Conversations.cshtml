@model MessageInboxView

<table class="table">
    <thead>
        <tr>
            <th class="col-2">Members</th>
            <th>Subject</th>
            <th class="col-1">Start Date</th>
            <th class="col-1">Latest Message Date</th>
        </tr>
    </thead>
    <tbody class="accordion" id="conversation-container">
        @foreach (InboxConversation conversation in @Model.Conversations)
        {
            <tr data-toggle="collapse" data-target="#conversation-@conversation.ConversationId" class='collapsed @(@conversation.UnreadCount() > 0 ? "bg-light font-weight-bold" : "")'>
                <td class="text-truncate td-member">
                    @String.Join(", ", conversation.Participating.Select(p => p.Name))
                </td>
                <td class="text-truncate">@conversation.Subject</td>
                <td>@conversation.DateCreated</td>
                <td>@conversation.DateLastMessage</td>
            </tr>
            <tr>
                <td colspan="4" class="p-0">
                    <div class="m-2 pl-5 collapse shadow-sm" id="conversation-@conversation.ConversationId" data-parent="#conversation-container">
                        @foreach (InboxMessage message in conversation.Messages)
                        {   
                            <div id="message-@message.MessageId" class='d-flex p-1 @(@message.Unread ? "bg-light font-weight-bold unread" : "")'>
                                <p class="font-weight-bold text-info">@conversation.Participating.SingleOrDefault(p => p.LinkId == message.SenderId).Name:</p>
                                <p class="col-8" colspan="2">@message.MessageText</p>
                                <p class="text-secondary">@message.Sent</p>
                            </div>
                        }
                            <partial name="_NewReply.cshtml" model="new ReplyView(){ConversationId = @conversation.ConversationId}" />
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
        $(document).ready(function() {
             $('.unread').click(function () {
                var $messageId = $(this).attr('id').split("-")[1];
                console.log($messageId);
                jQuery.post({
                    url: "/provider/inbox/message/read",
                    data: {"messageId" : $messageId},
                    success: function(data) {
                        console.log(data);
                        $("#message-" + $messageId).removeClass('font-weight-bold unread');
                        console.log(`Message Id ${data.messageId} marked unread.`);
                    }
                });
            });
        });
</script>