@model List<Patient>


<div class="d-flex">
    <h4 class="my-0 mr-auto">Patients <span class="badge badge-secondary">@Model.Count</span>:</h4>
    <a asp-controller="Patients" asp-action="PatientCreate" class="btn btn-outline-primary btn-sm">+</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>Patient ID</th>
            <th>Name</th>
            <th>DOB</th>
            <th>Registered Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Patient patient in @Model)
        {
        <tr>
            <td>@patient.PatientId</td>
            <td><a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patient.PatientId">@patient.FullName()</a></td>
            <td>@string.Format("{0:MM/dd/yyyy}", @patient.DOB)</td>
            <td>@patient.CreatedAt</td>
        </tr>
        }
    </tbody>
</table>
<nav aria-label="Result Pages Nav">
  <ul class="pagination justify-content-center">
    <li class="page-item"><a class="page-link" href="#">Previous</a></li>
    @for(int i = 1; i <= Math.Ceiling((double)@Model.Count/10); i++)
    {
        <li class="page-item"><a class="page-link" href="#">@i</a></li>
    }
    <li class="page-item"><a class="page-link" href="#">Next</a></li>
  </ul>
</nav>