@model PatientManagerView

@{
var search = new Dictionary<string, string>
            {
                {"SearchPatientId", @Model.SearchBar.SearchPatientId.ToString()},
                {"SearchFirstName", @Model.SearchBar.SearchFirstName},
                {"SearchLastName", @Model.SearchBar.SearchLastName},
                {"SearchBirthdate", @Model.SearchBar.SearchBirthdate.ToString()},
                {"SearchSSN", @Model.SearchBar.SearchSSN}
            };
}

<div class="d-flex">
    <h4 class="my-0 mr-auto">Patients <span class="badge badge-secondary">@Model.DisplayProperties.ResultsCount</span>:</h4>
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-expanded="false">
            Results per page...
        </button>
        <div class="dropdown-menu">
            @{int[] options = {5,10,20,50,100};
                foreach(int option in options)
                {
                    <a  class="dropdown-item" 
                    asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-SortOrder="@Model.DisplayProperties.SortOrder" 
                    asp-route-ResultsPerPage="@option"
                    >@option</a>
                }
            }
        </div>
    </div>
    <a asp-controller="Patients" asp-action="PatientCreate" class="btn btn-outline-primary btn-sm extend">+<span>  Add Patient</span></a>
</div>
<table class="table">
    <thead>
        <tr>
            <th class="align-middle text-muted">#</th>
            @* Already selected sort column link is changed to reverse direction *@
            @{
                var sorted = @Model.DisplayProperties;
                string[] sortFields = {"LastName", "DOB", "PatientId"};
                foreach(string sortField in sortFields)
                {
                <th>
                    <a asp-controller="Patients" asp-action="PatientManager" 
                    asp-all-route-data="search"
                    asp-route-ResultsPerPage="@Model.DisplayProperties.ResultsPerPage"
                    asp-route-SortOrder='@(sortField)_@(@sorted.SortColumn() == @sortField ? sorted.Reverse() : "desc")'>
                        @sortField
                    </a>
                </th>

                }
            }
            <th class="align-middle">SSN</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            foreach (Patient patient in @Model.SearchResults)
            {
                <tr>
                    <td class="text-muted">@(Model.DisplayProperties.ResultsPerPage*(Model.DisplayProperties.CurrentPage - 1) + i)</td>
                    <td><a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patient.PatientId">@patient.LastName, @patient.FirstName</a></td>
                    <td>@string.Format("{0:MM/dd/yyyy}", @patient.DOB) <span class="ml-1 text-muted">(@patient.Age)</span></td>
                    <td>@patient.PatientId</td>
                    <td>@patient.Last4SSN</td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>