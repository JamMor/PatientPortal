@model Patient

<table class="table">
    <tbody>
        <tr>
            <th class="col-3">Name</th>
            <td>@Model.FullName()</td>
        </tr>
        <tr>
            <th class="col-3">Date of Birth</th>
            <td>@string.Format("{0:MM/dd/yyyy}", @Model.DOB) <span class="ml-1 text-muted">(@Model.Age)</span></td>
        </tr>
        <tr>
            <th class="col-3">Medical Team</th>
            <td>
                <ul class="list-group list-group-flush">
                    @foreach (PatientStaffConnection person in @Model.MedicalTeam)
                    {
                        <li class="list-group-item pl-0 d-flex">
                            <p class="my-0 mr-auto">@person.Staff.FullName(), @person.Staff.Role</p> 
                            @if(@person.Staff.StaffId == @Context.Session.GetInt32("UserId"))
                            {
                            <form asp-controller="Patients" asp-action="MedicalTeamLeave" asp-route-patientId="@Model.PatientId">
                                <button class="btn btn-sm btn-outline-danger" href="#">Remove</button>
                            </form>
                            }
                        </li>
                    }
                    @if(!@Model.MedicalTeam.Any(team =>team.StaffId == @Context.Session.GetInt32("UserId")))
                    {
                        <li class="list-group-item text-right">
                            <form asp-controller="Patients" asp-action="MedicalTeamJoin" asp-route-patientId="@Model.PatientId">
                                <button class="btn btn-sm btn-outline-success" href="#">Join</button>
                            </form>
                        </li>
                    }                    
                </ul>
            </td>
        </tr>
        <tr>
            <th class="col-3">Health Issues</th>
            <td>
                <ul class="list-group list-group-flush">
                    @foreach (HealthIssue issue in @Model.HealthIssues)
                    {
                        <li class="card list-group-item">
                            <h6 class="card-header">
                                <a data-toggle="collapse" href="#issue-detail-@issue.HealthIssueId" class="text-decoration-none d-flex collapsed" aria-expanded="true" aria-controls="issue-detail-@issue.HealthIssueId">
                                    <span>@issue.ShortDescription</span>
                                    <i class="fas fa-chevron-down ml-auto"></i>
                                </a>
                            </h6>
                            <div id="issue-detail-@issue.HealthIssueId" class="collapse">
                                <div class="card-body">
                                    <p class="card-text">@issue.LongDescription</p>
                                    <p class="card-text">@issue.AssociatedTestResults.Count Related Tests</p>
                                    <p class="card-text">@issue.AssociatedVisits.Count Related Visits</p>
                                </div>
                                <div class="card-footer d-flex">
                                    <span>First Reported: @issue.CreatedAt</span>
                                    <form class="ml-auto" asp-controller="HealthIssue" asp-action="IssueDelete" asp-route-patientId="@Model.PatientId" asp-route-issueId="@issue.HealthIssueId">
                                        <button class="btn btn-sm btn-outline-danger" href="#">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                    <li class="list-group-item text-right"><a class ="btn btn-sm btn-outline-success" asp-controller="HealthIssue" asp-action="HealthIssueAdd" asp-route-patientId="@Model.PatientId">Add Health Issue</a></li>
                </ul>
            </td>
        </tr>
        <tr>
            <th class="col-3">Visits</th>
            <td>
                <ul class="list-group list-group-flush">
                    @foreach (Visit visit in @Model.Visits)
                    {
                        <li class="card list-group-item">
                            <h6 class="card-header">
                                <a data-toggle="collapse" href="#visit-detail-@visit.VisitId" class="text-decoration-none d-flex collapsed" aria-expanded="true" aria-controls="issue-detail-@visit.VisitId">
                                    <span>@visit.DateOfVisit</span>
                                    <i class="fas fa-chevron-down ml-auto"></i>
                                </a>
                            </h6>
                            <div id="visit-detail-@visit.VisitId" class="collapse">
                                <div class="card-body">
                                    <p class="card-text">@visit.Comment</p>
                                </div>
                                <div class="card-footer d-flex">
                                    <p>@visit.Staff.FullName(), @visit.Staff.Role</p>
                                    <form class="ml-auto" asp-controller="Visit" asp-action="VisitDelete" asp-route-patientId="@Model.PatientId" asp-route-visitId="@visit.VisitId">
                                        <button class="btn btn-sm btn-outline-danger" href="#">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                    <li class="list-group-item text-right"><a class ="btn btn-sm btn-outline-success" asp-controller="Visit" asp-action="VisitAdd" asp-route-patientId="@Model.PatientId">Add Visit</a></li>
                </ul>
            </td>
        </tr>
        <tr>
            <th class="col-3">Tests</th>
            <td>
                <ul class="list-group list-group-flush">
                    @foreach (TestResult test in @Model.Tests)
                    {
                        <li class="card list-group-item">
                            <h6 class="card-header">
                                <a data-toggle="collapse" href="#test-detail-@test.TestResultId" class="text-decoration-none d-flex collapsed" aria-expanded="true" aria-controls="test-detail-@test.TestResultId">
                                    <span>@test.Type - @test.CreatedAt</span>
                                    <i class="fas fa-chevron-down ml-auto"></i>
                                </a>
                            </h6>
                            <div id="test-detail-@test.TestResultId" class="collapse">
                                <div class="card-body">
                                    <p class="card-text">@test.Comment</p>
                                </div>
                                <div class="card-footer d-flex">
                                    <p>@test.Staff.FullName(), @test.Staff.Role</p>
                                    <form class-"ml-auto" asp-controller="TestResult" asp-action="TestResultDelete" asp-route-patientId="@Model.PatientId" asp-route-testId="@test.TestResultId">
                                        <button class="btn btn-sm btn-outline-danger" href="#">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                    <li class="list-group-item text-right"><a class ="btn btn-sm btn-outline-success" asp-controller="TestResult" asp-action="TestResultAdd" asp-route-patientId="@Model.PatientId">Add Test</a></li>
                </ul>
            </td>
        </tr>
        
        <tr>
            <th class="col-3">Added to System</th>
            <td>@Model.CreatedAt</td>
        </tr>
        <tr>
            <th class="col-3">Last Updated</th>
            <td>@Model.UpdatedAt</td>
        </tr>
    </tbody>
</table>
<form class="text-right" asp-controller="Patients" asp-action="PatientDelete" asp-route-patientId="@Model.PatientId">
    <button class="btn btn-sm btn-outline-danger" href="#">Delete Patient</button>
</form>