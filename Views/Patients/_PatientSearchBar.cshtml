@model PatientManagerView


<form asp-controller="Patients" asp-action="PatientManagerQuery" method="get"
    asp-route-DisplayProperties.SortOrder="@Model.DisplayProperties.SortOrder"
    asp-route-DisplayProperties.ResultsPerPage="@Model.DisplayProperties.ResultsPerPage"
    method="get" >
    <div class="form-row justify-content-around align-items-center flex-wrap">
        <div class="form-group col-auto">
            <input class="form-control" asp-for="@Model.SearchBar.SearchPatientId">
            <span class="text-danger" asp-validation-for="@Model.SearchBar.SearchPatientId"></span>
            <label class="form-label" asp-for="@Model.SearchBar.SearchPatientId"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="@Model.SearchBar.SearchFirstName">
            <span class="text-danger" asp-validation-for="@Model.SearchBar.SearchFirstName"></span>
            <label class="form-label" asp-for="@Model.SearchBar.SearchFirstName"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="@Model.SearchBar.SearchLastName">
            <span class="text-danger" asp-validation-for="@Model.SearchBar.SearchLastName"></span>
            <label class="form-label" asp-for="@Model.SearchBar.SearchLastName"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="@Model.SearchBar.SearchBirthdate">
            <span class="text-danger" asp-validation-for="@Model.SearchBar.SearchBirthdate"></span>
            <label class="form-label" asp-for="@Model.SearchBar.SearchBirthdate"></label>
        </div>
        <div class="form-group col-auto">
            <input class="form-control" asp-for="@Model.SearchBar.SearchSSN">
            <span class="text-danger" asp-validation-for="@Model.SearchBar.SearchSSN"></span>
            <label class="form-label" asp-for="@Model.SearchBar.SearchSSN"></label>
        </div>
    </div>
    <div class="text-center">
        <button class="btn btn-secondary m-1">Search</button>
        <a class="btn btn-outline-secondary m-1" asp-controller="Patients" asp-action="PatientManager">Clear</a>
    </div>
</form>