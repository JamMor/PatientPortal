@model TestResultFormView

<partial name="~/Views/Shared/_PatientInfoHeader.cshtml" for="Patient"/>

<h3>New Test Result: </h3>
<form asp-controller="TestResult" asp-action="TestResultCreate" asp-route-patientId="@Model.Patient.CurrentPatientId" method="post">
    <div class="form-group">
        <label class="form-label" asp-for="TestResult.Type"></label>
        <span class="text-danger" asp-validation-for="TestResult.Type"></span>
        <select class="form-control" asp-for="TestResult.Type">
            <option value="Vitals">Vitals</option>
            <option value="Labwork">Labwork</option>
            <option value="Pathology">Pathology</option>
            <option value="Imaging">Imaging</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="TestResult.Comment"></label>
        <span class="text-danger" asp-validation-for="TestResult.Comment"></span>
        <textarea class="form-control" asp-for="TestResult.Comment"></textarea>
    </div>
    <div class="form-group">
        @for(int i = 0; i < @Model.HealthIssues.Count; i++)
        {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="HealthIssues[i].Selected">
            <label class="form-check-label" asp-for="HealthIssues[i].Selected">
                @Model.HealthIssues[i].ShortDescription
            </label>
            <input class="form-check-input" type="hidden" asp-for="@Model.HealthIssues[i].HealthIssueId">
            <input class="form-check-input" type="hidden" asp-for="@Model.HealthIssues[i].ShortDescription">
        </div>
        }
    </div>
    <div class="custom-file my-3">
        <label class="custom-file-label" for="Upload">Related Documents:</label>
        <input class="custom-file-input" type="file" name="Upload" id="Upload">
    </div>
    <button class="btn btn-info">Submit Test Result</button>
    <a class="btn btn-outline-danger" asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@Model.Patient.CurrentPatientId">Cancel</a>
</form>