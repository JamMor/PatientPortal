@model TestResult

<h3>New Test Result: </h3>
<form asp-action="TestResultCreate" asp-controller="Staff" asp-route-patientId="@ViewBag.patientId" method="post">
    <div class="form-group">
        <label class="form-label" asp-for="Type"></label>
        <span class="text-danger" asp-validation-for="Type"></span>
        <select class="form-control" asp-for="Type">
            <option value="Vitals">Vitals</option>
            <option value="Labwork">Labwork</option>
            <option value="Pathology">Pathology</option>
            <option value="Imaging">Imaging</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Comment"></label>
        <span class="text-danger" asp-validation-for="Comment"></span>
        <input class="form-control" asp-for="Comment">
    </div>
    @foreach (HealthIssue issue in @ViewBag.HealthIssues)
    {
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="@(issue.HealthIssueId)" id="Issue@(issue.HealthIssueId)" name="issues[]">
        <label class="form-check-label" for="Issue@(issue.HealthIssueId)">
            @issue.ShortDescription
        </label>
    </div> 
    }
    <div class="form-group">
        <label class="form-label" for="Upload"></label>
        <input class="form-control"type="file" name="Upload" id="Upload">
    </div>
    <button class="btn btn-info">Submit Test Result</button>
</form>