@model List<Patient>

<div class="d-flex justify-content-between">
    <div class="form-group">
        <label for="" class="form-label">Future Firstname Search Field</label>
        <input type="text" class="form-control">
    </div>
    <div class="form-group">
        <label for="" class="form-label">Future Lastname Search Field</label>
        <input type="text" class="form-control">
    </div>
    <div class="form-group">
        <label for="" class="form-label">Future DOB Search Field</label>
        <input type="text" class="form-control">
    </div>
    <div class="form-group">
        <label for="" class="form-label">Future SSN Search Field</label>
        <input type="text" class="form-control">
    </div>
</div>
<hr>
<div class="d-flex">
    <h4 class="mr-auto">Patients:</h4>
    <a asp-controller="Patients" asp-action="PatientCreate" class="btn btn-outline-primary btn-sm">+</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>DOB</th>
            <th>Registered Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Patient patient in @Model)
        {
        <tr>
            <td><a asp-controller="Patients" asp-action="PatientInfo" asp-route-patientId="@patient.PatientId">@patient.FullName()</a></td>
            <td>@string.Format("{0:MM/dd/yyyy}", @patient.DOB)</td>
            <td>@patient.CreatedAt</td>
        </tr>
        }
    </tbody>
</table>